# Páginas de error y portada del sitio estático
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# Direcciones que no existen (por ejemplo las que inventa Google Ads) -> al inicio.
# Se conserva lo que venga después del ?, como gclid o utm_*, para no perder la medición.
# Mientras Cloudflare siga con la copia vieja de "/", se redirige a /index.html.
# Cuando la purguen, cambiar /index.html por / en la última línea de este bloque.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_URI} !\.(css|js|map|png|jpe?g|webp|svg|ico|woff2?|xml|txt|json)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [R=302,L]
</IfModule>


<IfModule mod_headers.c>
  # Páginas: nunca se guardan (ni en el navegador ni en Cloudflare), así los cambios se ven al instante.
  # Ojo: Cloudflare ignora "no-cache" y la guarda igual; solo respeta "no-store".
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

  # Archivos que cambian de nombre en cada compilación: se pueden guardar un año
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fotos, logos y fuentes: un día (si cambias una foto, se ve en máximo 24 horas)
  <FilesMatch "\.(woff2|webp|svg|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
