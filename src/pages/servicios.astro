---
/**
 * Listado de servicios. Las páginas de detalle salen de [slug].astro.
 * Todo el texto vive en src/datos/servicios-pagina.json y servicios.json.
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import pagina from "../datos/servicios-pagina.json";
import servicios from "../datos/servicios.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

const wa = (texto) => `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(texto)}`;
const { meta, hero, ayuda, proceso, cierre } = pagina;
const catalogo = servicios.categorias
  .map((c) => ({ ...c, items: servicios.items.filter((s) => s.categoria === c.id) }))
  .filter((c) => c.items.length);
const iconosPaso = ["search", "whatsapp", "check-circle", "shield-check"];
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="servicios">
  <header class="pagina-hero">
    <div class="container">
      <h1 class="reveal">{hero.titulo}</h1>
      <p class="lead reveal">{hero.texto}</p>
    </div>
  </header>

  <section class="pad">
    <div class="container">
      <div class="catalogo">
        {catalogo.map((c) => (
          <div class="cat-bloque reveal">
            <h2 class="cat-titulo">{c.titulo}</h2>
            <div class="cat-lista">
              {c.items.map((s) => (
                <a href={ruta(`/${s.slug}/`)}>
                  <span class="cat-icono"><Icon nombre={s.icono} tamano={20} /></span>
                  <span>
                    <span class="cat-nombre">{s.nombre}</span>
                    <span class="cat-resumen">{s.resumen}</span>
                  </span>
                  <Icon nombre="arrow-right" tamano={18} clase="flecha" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad fondo-alt">
    <div class="container">
      <div class="cabecera">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{proceso.titulo}</h2>
        </div>
      </div>
      <ol class="pasos" data-stagger>
        {proceso.pasos.map((p, i) => (
          <li class="paso reveal">
            <span class="paso-icono"><Icon nombre={iconosPaso[i] ?? "check"} tamano={24} /></span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pad">
    <div class="container">
      <div class="cabecera" style="margin-bottom:0">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{ayuda.titulo}</h2>
          <p class="lead reveal">{ayuda.texto}</p>
        </div>
        <a href={wa(sitio.mensajes.ayuda)} target="_blank" rel="noopener" class="btn btn-wa btn-lg reveal">
          <Icon nombre="whatsapp" tamano={19} />
          {ayuda.boton}
        </a>
      </div>
    </div>
  </section>

  <section class="cierre oscuro">
    <div class="container cierre-interior">
      <div>
        <h2 class="reveal">{cierre.titulo}</h2>
        <p class="reveal">{cierre.texto}</p>
      </div>
      <a href={wa(sitio.mensajes.general)} class="btn btn-claro btn-lg reveal" target="_blank" rel="noopener">
        <Icon nombre="whatsapp" tamano={19} />
        {cierre.boton}
      </a>
    </div>
  </section>
</Layout>
