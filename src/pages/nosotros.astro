---
/**
 * Nosotros. Todo el contenido viene de src/datos/nosotros.json.
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import datos from "../datos/nosotros.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

const { meta, hero, historia, principios, equipo, cifras, compromiso, cierre } = datos;
const wa = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(sitio.mensajes.general)}`;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="nosotros">
  <header class="pagina-hero">
    <div class="container">
      <h1 class="reveal">{hero.titulo}</h1>
      <p class="lead reveal">{hero.texto}</p>
    </div>
  </header>

  <section class="pad">
    <div class="container historia-grid">
      <figure class="reveal">
        <img src={ruta(hero.imagen)} alt={hero.imagenAlt} width="1200" height="1400" loading="lazy" />
      </figure>
      <div class="historia-texto">
        <h2 class="titulo-seccion reveal">{historia.titulo}</h2>
        {historia.parrafos.map((p) => <p class="reveal">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="pad fondo-alt">
    <div class="container">
      <div class="cabecera">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{principios.titulo}</h2>
        </div>
      </div>
      <div class="principios" data-stagger>
        {principios.items.map((p) => (
          <article class="principio reveal">
            <span class="principio-icono"><Icon nombre={p.icono} tamano={24} /></span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pad oscuro">
    <div class="container equipo-grid">
      <div>
        <h2 class="titulo-seccion reveal">{equipo.titulo}</h2>
        <p class="lead reveal">{equipo.texto}</p>
        <p class="lead reveal" style="margin-top:0.8rem;font-size:1rem">{equipo.nota}</p>
      </div>

      <div class="reveal">
        <h3 style="font-size:1.3rem">{compromiso.titulo}</h3>
        <ul class="compromiso-lista">
          {compromiso.items.map((c) => (
            <li><Icon nombre="check" tamano={18} trazo={2.4} /> {c}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="pad">
    <div class="container">
      <dl class="cifras-grid">
        {cifras.items.map((c) => (
          <div class="reveal">
            <dd class="cifra-numero" style="margin:0">{c.numero}{c.sufijo}</dd>
            <dt class="cifra-texto">{c.texto}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="cierre fondo-alt">
    <div class="container cierre-interior">
      <div>
        <h2 class="reveal">{cierre.titulo}</h2>
        <p class="reveal">{cierre.texto}</p>
      </div>
      <a href={wa} class="btn btn-wa btn-lg reveal" target="_blank" rel="noopener">
        <Icon nombre="whatsapp" tamano={19} />
        {cierre.boton}
      </a>
    </div>
  </section>
</Layout>
