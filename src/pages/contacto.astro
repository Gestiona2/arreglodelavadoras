---
/**
 * Contacto y agendamiento. El formulario abre WhatsApp con el mensaje armado.
 * El texto vive en src/datos/contacto.json.
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Formulario from "../components/Formulario.astro";
import datos from "../datos/contacto.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

const { meta, hero, canales, oficina, formulario, faq } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="contacto">
  <header class="pagina-hero">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span> {hero.eyebrow}</span>
      <h1>{hero.titulo}</h1>
      <p class="lead">{hero.texto}</p>
    </div>
  </header>

  <section class="pad" id="agendar">
    <div class="container contacto-grid">
      <div>
        <h2 class="titulo-seccion" style="font-size:clamp(1.6rem,2.6vw,2.1rem)">{canales.titulo}</h2>
        <div class="canales" style="margin-top:1.2rem">
          {canales.items.map((c) => (
            <a href={c.href} class="canal reveal-up" target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined}>
              <span class="canal-icono"><Icon nombre={c.icono} tamano={20} /></span>
              <span>
                <span class="canal-titulo">{c.titulo}</span>
                <span class="canal-texto">{c.texto}</span>
                <span class="canal-nota">{c.nota}</span>
              </span>
            </a>
          ))}
        </div>

        <div class="oficina reveal-up">
          <h3>{oficina.titulo}</h3>
          <p>{oficina.direccion}</p>
          <p style="margin-top:0.5rem">{oficina.nota}</p>
          <a href={oficina.mapa} target="_blank" rel="noopener">
            <Icon nombre="map-pin" tamano={15} />
            {oficina.mapaTexto}
          </a>
        </div>
      </div>

      <div class="panel-form reveal-up">
        <span class="eyebrow"><span class="dot"></span> {hero.eyebrow}</span>
        <h2 class="agendar-panel-titulo" style="margin-top:0.7rem;font-size:1.35rem">{formulario.titulo}</h2>
        <p class="agendar-panel-texto">{formulario.texto}</p>
        <Formulario />
      </div>
    </div>
  </section>

  {faq.items.length > 0 && (
    <section class="pad">
      <div class="container faq-grid">
        <div>
          <span class="eyebrow reveal"><span class="dot"></span> {faq.eyebrow}</span>
          <h2 class="titulo-seccion reveal" style="margin-top:1rem">{faq.titulo}</h2>
        </div>
        <div class="faq-lista">
          {faq.items.map((f) => (
            <details class="faq-item reveal-up">
              <summary class="faq-pregunta">
                {f.pregunta}
                <Icon nombre="plus" tamano={18} />
              </summary>
              <p class="faq-respuesta">{f.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
