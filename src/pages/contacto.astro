---
/**
 * Contacto y agendamiento. El formulario abre WhatsApp con el mensaje armado.
 * El texto vive en src/datos/contacto.json.
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Formulario from "../components/Formulario.astro";
import datos from "../datos/contacto.json";
import sitio from "../datos/sitio.json";

const { meta, hero, canales, cobertura, formulario, faq } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="contacto">
  <header class="pagina-hero">
    <div class="container">
      <h1 class="reveal">{hero.titulo}</h1>
      <p class="lead reveal">{hero.texto}</p>
    </div>
  </header>

  <section class="pad" id="agendar">
    <div class="container contacto-grid">
      <div>
        <h2 class="titulo-seccion" style="font-size:clamp(1.5rem,1.1rem + 1.4vw,2.1rem)">{canales.titulo}</h2>
        <div class="canales">
          {canales.items.map((c) => (
            <a href={c.href} class="canal reveal" target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined}>
              <span class="canal-icono"><Icon nombre={c.icono} tamano={22} /></span>
              <span>
                <span class="canal-titulo">{c.titulo}</span>
                <span class="canal-texto">{c.texto}</span>
                <span class="canal-nota">{c.nota}</span>
              </span>
            </a>
          ))}
        </div>

        <div class="cobertura-contacto reveal">
          <h3>{cobertura.titulo}</h3>
          <p>{cobertura.texto}</p>
          <div class="chips">
            {sitio.ciudades.map((c) => <span class="chip">{c.nombre}</span>)}
          </div>
        </div>
      </div>

      <div class="panel-form reveal">
        <h2 class="agendar-panel-titulo">{formulario.titulo}</h2>
        <p class="agendar-panel-texto">{formulario.texto}</p>
        <Formulario />
      </div>
    </div>
  </section>

  {faq.items.length > 0 && (
    <section class="pad fondo-alt">
      <div class="container faq-grid">
        <div class="faq-intro">
          <h2 class="titulo-seccion reveal">{faq.titulo}</h2>
        </div>
        <div class="faq-lista">
          {faq.items.map((f) => (
            <details class="faq-item">
              <summary class="faq-pregunta">
                {f.pregunta}
                <Icon nombre="plus" tamano={20} />
              </summary>
              <p class="faq-respuesta">{f.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
