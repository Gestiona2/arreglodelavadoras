---
/**
 * Página de inicio.
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/inicio.json.
 * Esta página define CÓMO se ve; el JSON define QUÉ dice.
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Formulario from "../components/Formulario.astro";
import inicio from "../datos/inicio.json";
import servicios from "../datos/servicios.json";
import contacto from "../datos/contacto.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

const { hero, marcas, donde, servicios: bloqueServicios, proceso, garantia, testimonios, faq, agendar, cierre, meta } = inicio;

const wa = `https://wa.me/${sitio.whatsapp}`;
const waGeneral = `${wa}?text=${encodeURIComponent(sitio.mensajes.general)}`;
const telefono = `tel:+${sitio.whatsapp}`;

const porSlug = Object.fromEntries(servicios.items.map((s) => [s.slug, s]));
const grupos = Object.entries(sitio.grupos).map(([id, g]) => ({
  id,
  ...g,
  items: g.servicios.map((slug) => porSlug[slug]).filter(Boolean),
}));
const catalogo = servicios.categorias
  .map((c) => ({ ...c, items: servicios.items.filter((s) => s.categoria === c.id) }))
  .filter((c) => c.items.length);

const iconosPaso = ["whatsapp", "calendar-check", "search", "shield-check"];
const [principal, ...lateral] = testimonios.items;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio">
  {/* ==================== PORTADA ==================== */}
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-titulo reveal">{hero.titulo}</h1>
        <p class="hero-texto reveal">{hero.texto}</p>

        <div class="hero-botones reveal">
          {hero.botones.map((b) =>
            b.tipo === "whatsapp" ? (
              <a href={waGeneral} class="btn btn-wa btn-lg" target="_blank" rel="noopener">
                <Icon nombre="whatsapp" tamano={20} />
                {b.texto}
              </a>
            ) : (
              <a href={telefono} class="btn btn-borde btn-lg">
                <Icon nombre="phone" tamano={19} />
                {b.texto}
              </a>
            )
          )}
        </div>

        <dl class="hero-hechos reveal">
          {hero.hechos.map((h) => (
            <div class="hecho">
              <dt class="hecho-texto">{h.texto}</dt>
              <dd class="hecho-valor">{h.valor}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero-visual reveal">
        <div class="ojo-buey">
          <img src={ruta(hero.imagen)} alt={hero.imagenAlt} width="1200" height="1400" loading="eager" fetchpriority="high" />
        </div>
        <div class="placa">
          <span class="placa-titulo">{hero.placa.titulo}</span>
          <a href={telefono} class="placa-numero">{sitio.telefono}</a>
          <div class="placa-acciones">
            <a href={telefono} class="btn btn-grafito"><Icon nombre="phone" tamano={17} /> {sitio.pie.llamar}</a>
            <a href={waGeneral} class="btn btn-wa" target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={17} /> {sitio.pie.escribir}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ==================== MARCAS ==================== */}
  <div class="marcas-tira">
    <div class="container">
      <p>{marcas.texto}</p>
      <div class="marcas-lista">
        {marcas.items.map((m) => <span>{m}</span>)}
      </div>
    </div>
  </div>

  {/* ==================== DÓNDE ATENDEMOS (selector por ciudad) ==================== */}
  <section class="pad oscuro donde" id="donde" data-donde data-mensaje={sitio.mensajes.ciudad} data-whatsapp={sitio.whatsapp} data-boton={donde.boton} data-titulo={donde.tituloPanel}>
    <div class="container donde-grid">
      <div>
        <h2 class="titulo-seccion reveal">{donde.titulo}</h2>
        <p class="lead reveal">{donde.texto}</p>

        <div class="ciudades-lista reveal" role="group" aria-label={donde.titulo}>
          {sitio.ciudades.map((c, i) => (
            <button type="button" class="ciudad-boton" data-grupo={c.grupo} data-ciudad={c.nombre} aria-pressed={i === 0 ? "true" : "false"}>
              {c.nombre}
            </button>
          ))}
        </div>

        <p class="donde-nota reveal">
          {donde.nota}{" "}
          <a href={waGeneral} target="_blank" rel="noopener">{donde.notaEnlace}</a>
        </p>
      </div>

      <div class="reveal" aria-live="polite">
        {grupos.map((g, i) => (
          <div class="panel-ciudad" data-panel={g.id}>
            <div class="panel-cabeza">
              <div>
                <h3 class="panel-titulo">
                  {donde.tituloPanel.split("{ciudad}")[0]}<span data-ciudad-nombre>{g.titulo}</span>{donde.tituloPanel.split("{ciudad}")[1]}
                </h3>
                <p class="panel-acciones">{g.acciones}</p>
              </div>
            </div>
            <div class="panel-servicios">
              {g.items.map((s) => (
                <a href={ruta(`/${s.slug}/`)}>
                  <Icon nombre={s.icono} tamano={20} />
                  {s.nombre}
                  <Icon nombre="arrow-right" tamano={16} clase="flecha" />
                </a>
              ))}
            </div>
            <div class="panel-pie">
              <a href={waGeneral} class="btn btn-wa btn-lg" target="_blank" rel="noopener" data-agendar>
                <Icon nombre="whatsapp" tamano={19} />
                <span data-agendar-texto>{sitio.ctaPrincipal.texto}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CATÁLOGO ==================== */}
  <section class="pad" id="servicios">
    <div class="container">
      <div class="cabecera">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{bloqueServicios.titulo}</h2>
          <p class="lead reveal">{bloqueServicios.texto}</p>
        </div>
        <a href={ruta(bloqueServicios.cta.href)} class="enlace-flecha reveal">
          {bloqueServicios.cta.texto}
          <Icon nombre="arrow-right" tamano={18} />
        </a>
      </div>

      <div class="catalogo">
        {catalogo.map((c) => (
          <div class="cat-bloque reveal">
            <h3 class="cat-titulo">{c.titulo}</h3>
            <div class="cat-lista">
              {c.items.map((s) => (
                <a href={ruta(`/${s.slug}/`)}>
                  <span class="cat-icono"><Icon nombre={s.icono} tamano={20} /></span>
                  <span>
                    <span class="cat-nombre">{s.nombre}</span>
                    <span class="cat-resumen">{s.resumen}</span>
                  </span>
                  <Icon nombre="arrow-right" tamano={18} clase="flecha" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== PROCESO ==================== */}
  <section class="pad fondo-alt">
    <div class="container">
      <div class="cabecera">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{proceso.titulo}</h2>
          <p class="lead reveal">{proceso.texto}</p>
        </div>
      </div>

      <ol class="pasos" data-stagger>
        {proceso.pasos.map((p, i) => (
          <li class="paso reveal">
            <span class="paso-icono"><Icon nombre={iconosPaso[i] ?? "check"} tamano={24} /></span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ==================== GARANTÍA ==================== */}
  <section class="garantia">
    <div class="container garantia-grid">
      <div class="reveal">
        <p class="garantia-cifra" aria-hidden="true">{garantia.cifra}</p>
        <p class="garantia-unidad"><span class="sr-only">{garantia.cifra} </span>{garantia.unidad}</p>
      </div>
      <div>
        <h2 class="reveal">{garantia.titulo}</h2>
        <p class="garantia-texto reveal">{garantia.texto}</p>
        <div class="garantia-items" data-stagger>
          {garantia.items.map((g) => (
            <div class="reveal">
              <h3>{g.titulo}</h3>
              <p>{g.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ==================== TESTIMONIOS ==================== */}
  <section class="pad">
    <div class="container">
      <div class="cabecera">
        <div class="cabecera-texto">
          <h2 class="titulo-seccion reveal">{testimonios.titulo}</h2>
          <p class="lead reveal">{testimonios.texto}</p>
        </div>
      </div>

      <div class="testimonios-grid">
        <figure class="testimonio reveal" style="margin:0">
          <blockquote class="testimonio-texto">{principal.texto}</blockquote>
          <figcaption class="testimonio-autor">
            <div class="testimonio-nombre">{principal.nombre}</div>
            <div class="testimonio-datos">{principal.ciudad} · {principal.equipo}</div>
          </figcaption>
        </figure>

        <div class="testimonios-lado">
          {lateral.map((t) => (
            <figure class="testimonio reveal" style="margin:0">
              <blockquote class="testimonio-texto">{t.texto}</blockquote>
              <figcaption class="testimonio-autor">
                <div class="testimonio-nombre">{t.nombre}</div>
                <div class="testimonio-datos">{t.ciudad} · {t.equipo}</div>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ==================== PREGUNTAS ==================== */}
  <section class="pad fondo-alt">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2 class="titulo-seccion reveal">{faq.titulo}</h2>
        <p class="lead reveal">{faq.ayudaTexto}</p>
        <a href={wa} class="btn btn-borde reveal" target="_blank" rel="noopener">
          <Icon nombre="whatsapp" tamano={18} />
          {faq.ayudaBoton}
        </a>
      </div>

      <div class="faq-lista">
        {faq.items.map((f) => (
          <details class="faq-item">
            <summary class="faq-pregunta">
              {f.pregunta}
              <Icon nombre="plus" tamano={20} />
            </summary>
            <p class="faq-respuesta">{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== AGENDAR ==================== */}
  <section class="pad" id="agendar">
    <div class="container agendar-grid">
      <div class="agendar-copy">
        <h2 class="reveal">{agendar.titulo}</h2>
        <p class="lead reveal">{agendar.texto}</p>

        <ul class="agendar-lista reveal">
          {agendar.puntos.map((p) => (
            <li><Icon nombre="check" tamano={18} trazo={2.4} /> {p}</li>
          ))}
        </ul>

        <div class="agendar-directo reveal">
          <p>{agendar.prefieres}</p>
          <a href={telefono}>
            <Icon nombre="phone" tamano={26} />
            {sitio.telefono}
          </a>
        </div>
      </div>

      <div class="agendar-panel reveal">
        <h3 class="agendar-panel-titulo">{contacto.formulario.titulo}</h3>
        <p class="agendar-panel-texto">{contacto.formulario.texto}</p>
        <Formulario compacto={true} />
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const seccion = document.querySelector("[data-donde]");
      if (!seccion) return;
      const botones = Array.from(seccion.querySelectorAll(".ciudad-boton"));
      const paneles = Array.from(seccion.querySelectorAll("[data-panel]"));
      const { mensaje, whatsapp, boton } = seccion.dataset;

      const elegir = (b) => {
        const ciudad = b.dataset.ciudad;
        botones.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        paneles.forEach((p) => {
          const activo = p.dataset.panel === b.dataset.grupo;
          p.hidden = !activo;
          if (!activo) return;
          p.querySelector("[data-ciudad-nombre]").textContent = ciudad;
          p.querySelector("[data-agendar-texto]").textContent = boton.replace("{ciudad}", ciudad);
          p.querySelector("[data-agendar]").href =
            "https://wa.me/" + whatsapp + "?text=" + encodeURIComponent(mensaje.replace("{ciudad}", ciudad));
          p.classList.remove("entra");
          void p.offsetWidth;
          p.classList.add("entra");
        });
      };

      botones.forEach((b) => b.addEventListener("click", () => elegir(b)));
      if (botones[0]) elegir(botones[0]);
    })();
  </script>
</Layout>
