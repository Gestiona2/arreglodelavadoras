---
/**
 * Páginas de detalle en la raíz: servicios (conserva las URLs antiguas) y
 * legales. Una sola ruta dinámica evita conflictos de prioridad.
 * El texto vive en servicios.json, servicios-pagina.json y legales.json.
 * Dónde se ofrece cada servicio sale de sitio.json (grupos de ciudades).
 */
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Formulario from "../components/Formulario.astro";
import servicios from "../datos/servicios.json";
import pagina from "../datos/servicios-pagina.json";
import legales from "../datos/legales.json";
import inicio from "../datos/inicio.json";
import contacto from "../datos/contacto.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

export function getStaticPaths() {
  return [
    ...servicios.items.map((servicio) => ({
      params: { slug: servicio.slug },
      props: { tipo: "servicio", servicio },
    })),
    ...legales.paginas.map((legal) => ({
      params: { slug: legal.slug },
      props: { tipo: "legal", legal },
    })),
  ];
}

const { tipo, servicio: s, legal: l } = Astro.props as any;
const { detalle } = pagina;

const wa = (texto: string) => `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(texto)}`;
const otros = tipo === "servicio" ? servicios.items.filter((x) => x.slug !== s.slug && x.categoria === s.categoria).concat(servicios.items.filter((x) => x.slug !== s.slug && x.categoria !== s.categoria)).slice(0, 6) : [];

// Grupos de ciudades donde se ofrece este servicio.
const donde = tipo === "servicio"
  ? Object.entries(sitio.grupos)
      .filter(([, g]: any) => g.servicios.includes(s.slug))
      .map(([id, g]: any) => ({
        titulo: g.titulo,
        acciones: g.acciones,
        ciudades: sitio.ciudades.filter((c) => c.grupo === id).map((c) => c.nombre),
      }))
  : [];

const titulo = tipo === "servicio" ? s.meta.titulo : `${l.titulo} · ${sitio.nombre}`;
const descripcion = tipo === "servicio" ? s.meta.descripcion : l.descripcion;
const activa = tipo === "servicio" ? "servicios" : "";
---

{tipo === "servicio" ? (
  <Layout titulo={titulo} descripcion={descripcion} activa={activa} imagen={s.imagen || undefined}>
    <header class="pagina-hero">
      <div class="container">
        <nav class="migas" aria-label="Ruta de navegación">
          <a href={ruta("/")}>Inicio</a>
          <span>/</span>
          <a href={ruta("/servicios/")}>Servicios</a>
          <span>/</span>
          <span class="actual">{s.nombre}</span>
        </nav>
        <h1>{s.titulo}</h1>
        <p class="lead">{s.subtitulo}</p>
        <a href={wa(`${sitio.mensajes.servicio} ${s.nombre.toLowerCase()}.`)} class="btn btn-wa btn-lg" target="_blank" rel="noopener">
          <Icon nombre="whatsapp" tamano={19} />
          {detalle.agendarTitulo}
        </a>
      </div>
    </header>

    <section class="pad">
      <div class="container detalle-grid">
        <div class="detalle-intro">
          {s.intro.map((p) => <p>{p}</p>)}

          <h2 class="bloque-titulo">{detalle.fallas}</h2>
          <ul class="fallas-lista">
            {s.fallas.map((f) => (
              <li><Icon nombre="alert-triangle" tamano={18} /> <span>{f}</span></li>
            ))}
          </ul>

          <h2 class="bloque-titulo">{detalle.incluye}</h2>
          <div class="incluye-grid">
            {s.incluye.map((i) => (
              <div class="incluye-item">
                <h3>{i.titulo}</h3>
                <p>{i.texto}</p>
              </div>
            ))}
          </div>

          {s.marcas.length > 0 && (
            <>
              <h2 class="bloque-titulo">{detalle.marcas}</h2>
              <div class="chips">
                {s.marcas.map((m) => <span class="chip">{m}</span>)}
              </div>
            </>
          )}
        </div>

        <aside class="detalle-aside">
          {s.imagen && (
            <figure class="detalle-img">
              <img src={ruta(s.imagen)} alt={s.imagenAlt} width="1200" height="900" loading="eager" />
            </figure>
          )}

          <div class="aside-caja">
            <h2>{detalle.agendarTitulo}</h2>
            <p>{detalle.agendarTexto}</p>
            <a href={wa(`${sitio.mensajes.servicio} ${s.nombre.toLowerCase()}.`)} class="btn btn-wa btn-full" target="_blank" rel="noopener">
              <Icon nombre="whatsapp" tamano={19} />
              {sitio.pie.escribir}
            </a>
            <a href={`tel:+${sitio.whatsapp}`} class="btn btn-borde btn-full">
              <Icon nombre="phone" tamano={18} />
              {sitio.telefono}
            </a>
          </div>

          <div class="aside-caja">
            <h2>{detalle.donde}</h2>
            <dl class="dondeaside">
              {donde.map((g) => (
                <div>
                  <dt>{g.titulo}</dt>
                  <dd>
                    {g.ciudades.length > 1 ? `${g.ciudades.join(", ")}. ` : ""}{g.acciones}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <section class="pad fondo-alt">
      <div class="container faq-grid">
        <div class="faq-intro">
          <h2 class="titulo-seccion">{detalle.faq}</h2>
          <p class="lead">{s.nombre}</p>
        </div>
        <div class="faq-lista">
          {s.faq.map((f) => (
            <details class="faq-item">
              <summary class="faq-pregunta">
                {f.pregunta}
                <Icon nombre="plus" tamano={20} />
              </summary>
              <p class="faq-respuesta">{f.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pad-sm">
      <div class="container">
        <div class="cabecera">
          <div class="cabecera-texto">
            <h2 class="titulo-seccion">{detalle.relacionados}</h2>
          </div>
          <a href={ruta("/servicios/")} class="enlace-flecha">
            {inicio.servicios.cta.texto}
            <Icon nombre="arrow-right" tamano={18} />
          </a>
        </div>
        <div class="relacionados">
          {otros.map((o) => (
            <a href={ruta(`/${o.slug}/`)} class="relacionado">
              <Icon nombre={o.icono} tamano={19} />
              {o.nombre}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="pad" id="agendar">
      <div class="container agendar-grid">
        <div class="agendar-copy">
          <h2>{inicio.agendar.titulo}</h2>
          <p class="lead">{inicio.agendar.texto}</p>
          <div class="agendar-directo">
            <p>{inicio.agendar.prefieres}</p>
            <a href={`tel:+${sitio.whatsapp}`}>
              <Icon nombre="phone" tamano={26} />
              {sitio.telefono}
            </a>
          </div>
        </div>
        <div class="agendar-panel">
          <h3 class="agendar-panel-titulo">{contacto.formulario.titulo}</h3>
          <p class="agendar-panel-texto">{contacto.formulario.texto}</p>
          <Formulario compacto={true} />
        </div>
      </div>
    </section>
  </Layout>
) : (
  <Layout titulo={titulo} descripcion={descripcion} activa="">
    <header class="pagina-hero">
      <div class="container">
        <nav class="migas" aria-label="Ruta de navegación">
          <a href={ruta("/")}>Inicio</a>
          <span>/</span>
          <span class="actual">{l.titulo}</span>
        </nav>
        <h1>{l.titulo}</h1>
        <p class="lead">{l.descripcion}</p>
      </div>
    </header>

    <section class="pad">
      <div class="container legal-grid">
        <aside class="legal-indice" aria-label="Contenido de la página">
          <p>{legales.indice}</p>
          {l.bloques.map((b, i) => (
            <a href={`#bloque-${i + 1}`}>{b.titulo}</a>
          ))}
        </aside>

        <div class="legal-cuerpo">
          <span class="legal-fecha">{legales.actualizado}: {l.actualizado}</span>
          {l.bloques.map((b, i) => (
            <section class="legal-bloque" id={`bloque-${i + 1}`}>
              <h2>{b.titulo}</h2>
              {b.parrafos.map((p) => <p>{p}</p>)}
            </section>
          ))}
          <p class="legal-pie">
            {legales.pie}{" "}
            <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>.
          </p>
        </div>
      </div>
    </section>
  </Layout>
)}
