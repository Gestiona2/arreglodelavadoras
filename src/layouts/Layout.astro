---
/**
 * Layout general. Aquí vive lo que se repite en todas las páginas:
 * metadatos, menú, pie, botón de tema y el botón flotante de WhatsApp.
 * El contenido editable NO se escribe aquí: sale de src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";
import servicios from "../datos/servicios.json";
import { ruta, enlace } from "../lib/ruta.js";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
  imagen?: string;
}
const {
  titulo,
  descripcion = sitio.descripcion,
  activa = "",
  imagen = "/brand/og.jpg",
} = Astro.props;

const origen = Astro.site ?? new URL(sitio.dominio);
const url = new URL(Astro.url.pathname, origen);
const urlSitio = new URL(import.meta.env.BASE_URL, origen).href;
const ogImagen = new URL(ruta(imagen), origen);

const telefono = `tel:+${sitio.whatsapp}`;
const whatsapp = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(sitio.mensajes.general)}`;
const categorias = servicios.categorias
  .map((c) => ({ ...c, items: servicios.items.filter((s) => s.categoria === c.id) }))
  .filter((c) => c.items.length);

// Las fuentes se declaran aquí (y no en global.css) para que respeten la base
// del sitio cuando se publica en una subcarpeta, como la demo.
const fuentes = `
@font-face{font-family:"Sora";src:url("${ruta("/fonts/sora-latin.woff2")}") format("woff2");font-style:normal;font-weight:300 800;font-display:swap}
@font-face{font-family:"Instrument Sans";src:url("${ruta("/fonts/instrument-sans-latin.woff2")}") format("woff2");font-style:normal;font-weight:400 700;font-display:swap}
`;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: sitio.nombre,
  description: sitio.descripcion,
  url: urlSitio,
  image: ogImagen.href,
  logo: new URL(ruta("/brand/logo-tinta.png"), origen).href,
  telephone: `+${sitio.whatsapp}`,
  priceRange: "$$",
  address: { "@type": "PostalAddress", addressCountry: "CO" },
  areaServed: sitio.ciudades.map((c) => ({ "@type": "City", name: c.nombre })),
  openingHours: "Mo-Sa 08:00-18:00",
  sameAs: sitio.redes.filter((r) => r.href).map((r) => r.href),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios técnicos",
    itemListElement: servicios.items.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.nombre, url: new URL(ruta(`/${s.slug}/`), origen).href },
    })),
  },
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url.href} />
    <link rel="icon" href={ruta("/brand/favicon.png")} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={ruta("/brand/apple-touch-icon.png")} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={ogImagen.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen.href} />

    <link rel="preload" href={ruta("/fonts/sora-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ruta("/fonts/instrument-sans-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fuentes}></style>

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!-- Tema antes de pintar. Siempre claro, salvo que el visitante haya elegido oscuro. -->
    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add("js");
        try {
          raiz.setAttribute("data-theme", localStorage.getItem(clave) === "dark" ? "dark" : "light");
        } catch (e) {
          raiz.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <a class="salto-contenido" href="#contenido">{sitio.pie.saltar}</a>

    <!-- ==================== MENÚ ==================== -->
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <Logo />

        <nav class="nav-links" id="navLinks" aria-label={sitio.pie.principal}>
          {sitio.menu.map((item) =>
            item.desplegable ? (
              <div class:list={["nav-grupo", { activo: activa === item.id }]}>
                <button class="nav-grupo-boton" aria-expanded="false" aria-controls={`sub-${item.id}`}>
                  {item.texto}
                  <Icon nombre="chevron-down" tamano={16} />
                </button>
                <div class="nav-sub" id={`sub-${item.id}`}>
                  <div class="nav-sub-grid">
                    {categorias.map((c) => (
                      <div class="nav-sub-col">
                        <p class="nav-sub-titulo">{c.titulo}</p>
                        {c.items.map((s) => (
                          <a href={ruta(`/${s.slug}/`)}>
                            <Icon nombre={s.icono} tamano={18} />
                            <span>{s.nombre}</span>
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                  <a href={enlace(item.href)} class="nav-sub-todos">
                    <span>{sitio.pie.verTodos}</span>
                    <Icon nombre="arrow-right" tamano={18} />
                  </a>
                </div>
              </div>
            ) : (
              <a href={enlace(item.href)} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
            )
          )}
        </nav>

        <div class="nav-acciones">
          <a href={telefono} class="nav-tel" aria-label={`${sitio.pie.llamar} ${sitio.telefono}`}>
            <Icon nombre="phone" tamano={18} />
            <span>{sitio.telefono}</span>
          </a>
          <button id="botonTema" class="boton-icono" aria-label={sitio.pie.tema.aOscuro} data-claro={sitio.pie.tema.aClaro} data-oscuro={sitio.pie.tema.aOscuro}>
            <Icon nombre="moon" tamano={19} />
          </button>
          <a href={whatsapp} class="btn btn-wa nav-cta" target="_blank" rel="noopener">
            <Icon nombre="whatsapp" tamano={18} />
            {sitio.pie.escribir}
          </a>
          <button id="botonMenu" class="boton-icono boton-menu" aria-label={sitio.pie.menuAbrir} aria-expanded="false" aria-controls="navLinks" data-abrir={sitio.pie.menuAbrir} data-cerrar={sitio.pie.menuCerrar}>
            <Icon nombre="menu" tamano={22} />
          </button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <div class="container">
        <div class="pie-top">
          <div class="pie-marca">
            <Logo sobreOscuro />
            <p>{sitio.pie.descripcion}</p>
            <div class="pie-redes">
              {sitio.redes.filter((r) => r.href).map((r) => (
                <a href={r.href} target="_blank" rel="noopener" aria-label={r.nombre}>
                  <Icon nombre={r.icono} tamano={20} />
                </a>
              ))}
              <a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
                <Icon nombre="whatsapp" tamano={20} />
              </a>
            </div>
          </div>

          <div class="pie-col">
            <h3>{sitio.pie.tituloServicios}</h3>
            <nav aria-label={sitio.pie.tituloServicios}>
              {servicios.items.map((s) => <a href={ruta(`/${s.slug}/`)}>{s.nombre}</a>)}
            </nav>
          </div>

          <div class="pie-col">
            <h3>{sitio.pie.tituloCobertura}</h3>
            <ul>
              {sitio.ciudades.map((c) => <li>{c.nombre}</li>)}
            </ul>
          </div>

          <div class="pie-col pie-contacto">
            <h3>{sitio.pie.tituloContacto}</h3>
            <a href={telefono}><Icon nombre="phone" tamano={17} /> {sitio.telefono}</a>
            <a href={whatsapp} target="_blank" rel="noopener"><Icon nombre="whatsapp" tamano={17} /> WhatsApp</a>
            <span><Icon nombre="clock" tamano={17} /> {sitio.horario}</span>
            <a href={enlace(sitio.ctaPrincipal.href)} class="btn btn-borde pie-cta">
              {sitio.ctaPrincipal.texto}
              <Icon nombre="arrow-right" tamano={18} />
            </a>
          </div>
        </div>

        <div class="pie-bottom">
          <p>&copy; {new Date().getFullYear()} {sitio.razonSocial}. {sitio.pie.derechos}</p>
          <nav class="legales" aria-label="Legales">
            {sitio.legales.map((l) => <a href={enlace(l.href)}>{l.texto}</a>)}
          </nav>
        </div>
        <p class="pie-aviso">{sitio.pie.aviso}</p>
      </div>
    </footer>

    <a href={whatsapp} class="flota-wa" target="_blank" rel="noopener" aria-label={sitio.pie.waAria}>
      <Icon nombre="whatsapp" tamano={24} />
      <span>{sitio.pie.flotante}</span>
    </a>

    <!-- Barra fija para celular: las dos acciones que convierten. -->
    <div class="barra-movil" aria-label={sitio.pie.contactoRapido}>
      <a href={telefono} class="barra-movil-item">
        <Icon nombre="phone" tamano={20} />
        {sitio.pie.llamar}
      </a>
      <a href={whatsapp} class="barra-movil-item barra-movil-wa" target="_blank" rel="noopener">
        <Icon nombre="whatsapp" tamano={20} />
        {sitio.pie.escribir}
      </a>
    </div>

    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        const $ = (s, c = document) => c.querySelector(s);
        const $$ = (s, c = document) => Array.from(c.querySelectorAll(s));
        const raiz = document.documentElement;
        const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const svg = (d) => '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + "</svg>";
        const ICONO_LUNA = svg('<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>');
        const ICONO_SOL = svg('<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>');
        const ICONO_MENU = svg('<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>');
        const ICONO_CERRAR = svg('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>');

        /* ---------- Tema claro / oscuro ---------- */
        const botonTema = $("#botonTema");
        const pintarBotonTema = () => {
          const oscuro = raiz.getAttribute("data-theme") === "dark";
          botonTema.innerHTML = oscuro ? ICONO_SOL : ICONO_LUNA;
          botonTema.setAttribute("aria-label", oscuro ? botonTema.dataset.claro : botonTema.dataset.oscuro);
        };
        botonTema?.addEventListener("click", () => {
          const siguiente = raiz.getAttribute("data-theme") === "dark" ? "light" : "dark";
          raiz.setAttribute("data-theme", siguiente);
          try { localStorage.setItem(clave, siguiente); } catch (e) {}
          pintarBotonTema();
        });
        pintarBotonTema();

        /* ---------- Menú en celular ---------- */
        const botonMenu = $("#botonMenu");
        const navLinks = $("#navLinks");
        const ponerMenu = (abierto) => {
          navLinks.classList.toggle("abierto", abierto);
          botonMenu.setAttribute("aria-expanded", String(abierto));
          botonMenu.setAttribute("aria-label", abierto ? botonMenu.dataset.cerrar : botonMenu.dataset.abrir);
          botonMenu.innerHTML = abierto ? ICONO_CERRAR : ICONO_MENU;
          document.body.classList.toggle("menu-abierto", abierto);
        };
        botonMenu?.addEventListener("click", () => ponerMenu(!navLinks.classList.contains("abierto")));
        $$("#navLinks a").forEach((a) => a.addEventListener("click", () => ponerMenu(false)));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") ponerMenu(false); });
        window.addEventListener("resize", () => { if (window.innerWidth > 980) ponerMenu(false); });

        /* ---------- Submenú de servicios ---------- */
        $$(".nav-grupo").forEach((grupo) => {
          const boton = grupo.querySelector(".nav-grupo-boton");
          boton.addEventListener("click", () => {
            const abierto = grupo.classList.toggle("sub-abierto");
            boton.setAttribute("aria-expanded", String(abierto));
          });
          grupo.addEventListener("mouseenter", () => { if (window.innerWidth > 980) boton.setAttribute("aria-expanded", "true"); });
          grupo.addEventListener("mouseleave", () => {
            if (window.innerWidth > 980) {
              grupo.classList.remove("sub-abierto");
              boton.setAttribute("aria-expanded", "false");
            }
          });
        });

        /* ---------- Línea bajo el menú al bajar ---------- */
        const nav = $("#nav");
        const alBajar = () => nav.classList.toggle("bajado", window.scrollY > 8);
        window.addEventListener("scroll", alBajar, { passive: true });
        alBajar();

        /* ---------- Apariciones al bajar ---------- */
        // Entrada por partes: los hijos de cada grupo aparecen uno tras otro.
        const GRUPOS = ".hero-copy, .hero-hechos, .marcas-lista, .ciudades-lista, .cat-lista, .faq-lista, .fallas-lista, .incluye-grid, .testimonios-lado, .chips, .relacionados, .agendar-lista, .compromiso-lista, .cifras-grid, .marcas-grid, .pasos, .principios, .garantia-items, .canales, [data-stagger]";
        $$(GRUPOS).forEach((grupo) => {
          Array.from(grupo.children).forEach((hijo, i) => {
            hijo.classList.add("reveal");
            hijo.style.setProperty("--i", Math.min(i, 9));
          });
        });
        const apariciones = $$(".reveal");
        if (menosMovimiento || !("IntersectionObserver" in window)) {
          apariciones.forEach((el) => el.classList.add("seen"));
        } else {
          const observador = new IntersectionObserver(
            (entradas) => {
              entradas.forEach((entrada) => {
                if (entrada.isIntersecting) {
                  const el = entrada.target;
                  el.classList.add("seen");
                  observador.unobserve(el);
                  // Terminada la entrada, el elemento vuelve a su estilo normal
                  // (así el retraso escalonado no frena los efectos al pasar el ratón).
                  el.addEventListener("transitionend", function fin(e) {
                    if (e.target !== el || e.propertyName !== "opacity") return;
                    el.removeEventListener("transitionend", fin);
                    el.classList.remove("reveal", "seen");
                    el.style.removeProperty("--i");
                  });
                }
              });
            },
            { threshold: 0.1, rootMargin: "0px 0px -4% 0px" }
          );
          apariciones.forEach((el) => observador.observe(el));
        }
      })();
    </script>
  </body>
</html>
