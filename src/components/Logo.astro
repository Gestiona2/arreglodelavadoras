---
/**
 * Logo dibujado en código: el frente de una lavadora (cuerpo, ojo de buey y
 * mando) más el nombre. Sustituye a los PNG mientras no llegue el vector
 * original del cliente. Los colores salen de los tokens, así que cambia solo
 * entre tema claro, oscuro y bandas oscuras.
 */
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

interface Props { clase?: string }
const { clase = "" } = Astro.props;
---

<a href={ruta("/")} class={`logo ${clase}`} aria-label={`${sitio.nombre}: ${sitio.tagline}`}>
  <svg class="logo-icono" width="38" height="38" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect class="cuerpo" width="40" height="40" rx="10" />
    <rect class="mando" x="8" y="7" width="7" height="3" rx="1.5" />
    <circle class="ojo" cx="20" cy="23" r="11" />
    <circle class="centro" cx="20" cy="23" r="5" />
  </svg>
  <span class="logo-texto"><b>Arreglo</b> de <b>Lavadoras</b></span>
</a>
