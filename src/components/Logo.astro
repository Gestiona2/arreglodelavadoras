---
/**
 * Logo del cliente (archivos reales en public/brand/). Versión tinta para fondo
 * claro y versión blanca para el tema oscuro y para bandas oscuras como el pie.
 * `sobreOscuro` fuerza la versión blanca.
 */
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

interface Props { sobreOscuro?: boolean }
const { sobreOscuro = false } = Astro.props;
---

<a href={ruta("/")} class:list={["logo", { "logo--sobre-oscuro": sobreOscuro }]} aria-label={`${sitio.nombre}: ${sitio.tagline}`}>
  <img class="l-claro" src={ruta("/brand/logo-tinta.png")} alt={sitio.nombre} width="503" height="79" />
  <img class="l-oscuro" src={ruta("/brand/logo-blanco.png")} alt="" width="503" height="79" />
</a>
