---
/**
 * Logo del cliente (archivos en public/brand/, derivados de brand-fuente/).
 * - Normal: versión compacta a color (símbolo + nombre) para el menú.
 * - sobreOscuro: versión blanca apilada para el pie y bandas oscuras.
 * El logo completo con descriptor es public/brand/logo-completo.png.
 */
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta.js";

interface Props { sobreOscuro?: boolean }
const { sobreOscuro = false } = Astro.props;
---

<a href={ruta("/")} class:list={["logo", { "logo--sobre-oscuro": sobreOscuro }]} aria-label={`${sitio.nombre}: ${sitio.tagline}`}>
  {sobreOscuro ? (
    <img src={ruta("/brand/logo-blanco.png")} alt={sitio.nombre} width="900" height="624" loading="lazy" />
  ) : (
    <img src={ruta("/brand/logo.png")} alt={sitio.nombre} width="1000" height="319" />
  )}
</a>
