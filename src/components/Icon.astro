const rellenos = new Set(["whatsapp", "facebook", "tiktok"]);
const esRelleno = rellenos.has(nombre);
const contenido = iconos[nombre] ?? iconos["check"];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill={esRelleno ? "currentColor" : "none"}
  stroke={esRelleno ? "none" : "currentColor"}
  stroke-width={trazo}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`icono ${clase}`}
  aria-hidden="true"
  focusable="false"
  set:html={contenido}
/>
